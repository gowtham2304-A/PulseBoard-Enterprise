# PulseBoard Configuration Example

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pulseboard
ALLOWED_ORIGINS=http://localhost:5173
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Source Control Provider Selection ("github" or "gitlab")
SOURCE_CONTROL_PROVIDER=github

# GitHub Provider Settings (used when SOURCE_CONTROL_PROVIDER=github)
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-github-repo-name
GITHUB_TOKEN=your_github_personal_access_token

# GitLab Provider Settings (used when SOURCE_CONTROL_PROVIDER=gitlab)
GITLAB_URL=https://gitlab.com
GITLAB_PROJECT_ID=your_gitlab_project_id_or_path
GITLAB_TOKEN=your_gitlab_personal_access_token
